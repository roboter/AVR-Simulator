<Window x:Class="AVR_Simulator.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="AVR Simulator" Height="640" Width="700"
		Loaded="Window_Loaded" Closing="Window_Closing"
		Background="#1E1E2E">

	<Window.Resources>
		<!-- Section header -->
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#CDD6F4"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<!-- Port label (compact) -->
		<Style x:Key="PinLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#BAC2DE"/>
			<Setter Property="FontFamily" Value="Consolas"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Card panel -->
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="#313244"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
		</Style>

		<!-- Menu bar style -->
		<Style x:Key="DarkMenu" TargetType="Menu">
			<Setter Property="Background" Value="#181825"/>
			<Setter Property="Foreground" Value="#CDD6F4"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="4,3"/>
		</Style>

		<Style x:Key="DarkMenuItem" TargetType="MenuItem">
			<Setter Property="Foreground" Value="#CDD6F4"/>
			<Setter Property="Background" Value="#181825"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</Window.Resources>

	<DockPanel>

		<!-- ── Menu bar ──────────────────────────────────────── -->
		<Menu DockPanel.Dock="Top" Style="{StaticResource DarkMenu}">
			<MenuItem Header="_File" Style="{StaticResource DarkMenuItem}">

				<MenuItem x:Name="MenuLoad"
				          Header="_Load HEX File…"
				          InputGestureText="Ctrl+O"
				          Click="MenuLoad_Click"
				          Style="{StaticResource DarkMenuItem}">
					<MenuItem.Icon><TextBlock Text="📂" FontSize="13"/></MenuItem.Icon>
				</MenuItem>

				<MenuItem x:Name="MenuBlink"
				          Header="Load _Blink Example"
				          Click="MenuBlink_Click"
				          Style="{StaticResource DarkMenuItem}">
					<MenuItem.Icon><TextBlock Text="💡" FontSize="13"/></MenuItem.Icon>
				</MenuItem>

				<MenuItem x:Name="MenuRecent"
				          Header="_Recent Files"
				          Style="{StaticResource DarkMenuItem}">
					<MenuItem.Icon><TextBlock Text="🕐" FontSize="13"/></MenuItem.Icon>
				</MenuItem>

				<Separator Background="#45475A"/>

				<MenuItem x:Name="MenuClose"
				          Header="_Close Project"
				          IsEnabled="False"
				          Click="MenuClose_Click"
				          Style="{StaticResource DarkMenuItem}">
					<MenuItem.Icon><TextBlock Text="⏹" FontSize="13"/></MenuItem.Icon>
				</MenuItem>

				<Separator Background="#45475A"/>

				<MenuItem Header="E_xit"
				          Click="MenuExit_Click"
				          Style="{StaticResource DarkMenuItem}">
					<MenuItem.Icon><TextBlock Text="✖" FontSize="13"/></MenuItem.Icon>
				</MenuItem>

			</MenuItem>
		</Menu>

		<!-- ── Status bar ─────────────────────────────────────── -->
		<StatusBar DockPanel.Dock="Bottom" Background="#181825" Padding="6,2">
			<TextBlock x:Name="StatusText"
			           Text="No project loaded"
			           Foreground="#6C7086"
			           FontFamily="Consolas" FontSize="11"/>
		</StatusBar>

		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="14">

			<!-- ── ADC Control ───────────────────────────── -->
			<Border Style="{StaticResource Card}">
				<StackPanel>
					<TextBlock Text="🎛  ADC Control" Style="{StaticResource SectionHeader}"/>

					<TextBlock Text="Manual Voltage (0–5 V):" Foreground="#BAC2DE" FontSize="11" FontFamily="Segoe UI"/>
					<DockPanel Margin="0,4,0,0">
						<TextBlock Text="{Binding ElementName=VoltageSlider, Path=Value, StringFormat={}{0:F2} V}"
								   Width="52" DockPanel.Dock="Right" VerticalAlignment="Center"
								   Foreground="#CDD6F4" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"/>
						<Slider Name="VoltageSlider" Minimum="0" Maximum="5" Value="0"
								TickFrequency="0.1" IsSnapToTickEnabled="False"/>
					</DockPanel>

					<CheckBox Name="SineWaveCheckBox" Content="Enable Sine Wave Mode"
							  Foreground="#BAC2DE" FontFamily="Segoe UI" FontSize="11" Margin="0,8,0,0"/>

					<StackPanel IsEnabled="{Binding ElementName=SineWaveCheckBox, Path=IsChecked}" Margin="0,4,0,0">
						<TextBlock Text="Frequency (Hz):" Foreground="#BAC2DE" FontSize="11" FontFamily="Segoe UI"/>
						<DockPanel Margin="0,4,0,0">
							<TextBlock Text="{Binding ElementName=FreqSlider, Path=Value, StringFormat={}{0:F1} Hz}"
									   Width="52" DockPanel.Dock="Right" VerticalAlignment="Center"
									   Foreground="#CDD6F4" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"/>
							<Slider Name="FreqSlider" Minimum="0.1" Maximum="10" Value="1"
									TickFrequency="0.1" IsSnapToTickEnabled="False"/>
						</DockPanel>
						<TextBlock Text="Amplitude (V):" Foreground="#BAC2DE" FontSize="11" FontFamily="Segoe UI" Margin="0,4,0,0"/>
						<DockPanel Margin="0,4,0,0">
							<TextBlock Text="{Binding ElementName=AmpSlider, Path=Value, StringFormat={}{0:F1} V}"
									   Width="52" DockPanel.Dock="Right" VerticalAlignment="Center"
									   Foreground="#CDD6F4" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"/>
							<Slider Name="AmpSlider" Minimum="0" Maximum="2.5" Value="2.5"
									TickFrequency="0.1" IsSnapToTickEnabled="False"/>
						</DockPanel>
					</StackPanel>

					<TextBlock Name="CurrentValueText" Text="Current ADC Input: 0.00 V"
							   Foreground="#89DCEB" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
				</StackPanel>
			</Border>

			<!-- ── DAC Output ────────────────────────────── -->
			<Border Style="{StaticResource Card}">
				<StackPanel>
					<TextBlock Text="📤  Virtual DAC Output" Style="{StaticResource SectionHeader}"/>
					<TextBlock Name="DACOutputText" Text="DAC Voltage: 0.00 V (0x00)"
							   Foreground="#A6E3A1" FontFamily="Consolas" FontSize="11"/>
				</StackPanel>
			</Border>

			<!-- ── GPIO Ports (3 columns, compact) ────────── -->
			<Border Style="{StaticResource Card}">
				<StackPanel>
					<TextBlock Text="🔌  GPIO Ports" Style="{StaticResource SectionHeader}"/>

					<!-- Legend -->
					<StackPanel Orientation="Horizontal" Margin="0,0,0,6">
						<Ellipse Width="8" Height="8" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,4,0"/>
						<TextBlock Text="HIGH" Foreground="#6C7086" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
						<Ellipse Width="8" Height="8" Fill="#45475A" VerticalAlignment="Center" Margin="0,0,4,0"/>
						<TextBlock Text="LOW" Foreground="#6C7086" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
						<TextBlock Text="●=OUT  ○=IN(click to toggle)" Foreground="#585B70" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center"/>
					</StackPanel>

					<!-- Three port columns side-by-side -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="8"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="8"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- PORTB -->
						<StackPanel Grid.Column="0">
							<TextBlock Text="PORTB" Foreground="#CBA6F7" FontFamily="Consolas"
							           FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
							<ItemsControl Name="PortBPanel"/>
						</StackPanel>

						<Rectangle Grid.Column="1" Fill="#45475A" Width="1"/>

						<!-- PORTC -->
						<StackPanel Grid.Column="2">
							<TextBlock Text="PORTC" Foreground="#89B4FA" FontFamily="Consolas"
							           FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
							<ItemsControl Name="PortCPanel"/>
						</StackPanel>

						<Rectangle Grid.Column="3" Fill="#45475A" Width="1"/>

						<!-- PORTD -->
						<StackPanel Grid.Column="4">
							<TextBlock Text="PORTD" Foreground="#F38BA8" FontFamily="Consolas"
							           FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
							<ItemsControl Name="PortDPanel"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

		</StackPanel>
		</ScrollViewer>

	</DockPanel>
</Window>
